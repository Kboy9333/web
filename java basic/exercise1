function challenge1(width, height) {

    let rectangleString = '';

    for (let i = 0; i < width; i++) {
	    for (let j = 0; j < height; j++) {
		    rectangleString += '*';
        }
        rectangleString += '\n';
    }
    return rectangleString;
}

console.log(challenge1(4, 3));
console.log(challenge1(2, 5));
console.log(challenge1(-2, 5));
